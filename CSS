* {
  box-sizing: border-box;
}

:root {
  --background: #050706;
  --panel: rgba(13, 20, 16, 0.72);
  --panel-solid: #0d1510;
  --border: rgba(120, 160, 130, 0.16);
  --green: #57f287;
  --green-dark: #1fa854;
  --text: #f5f8f5;
  --muted: #8b978e;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 50% -20%,
      #183b24 0%,
      #0b130e 30%,
      var(--background) 65%
    );

  color: var(--text);

  font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;

  overflow-x: hidden;
}


/* BACKGROUND */

.background-glow {
  position: fixed;

  width: 500px;
  height: 500px;

  border-radius: 50%;

  filter: blur(120px);

  opacity: .08;

  pointer-events: none;

  z-index: -1;
}

.glow-one {
  top: 10%;
  left: -250px;
  background: #32e878;
}

.glow-two {
  top: 55%;
  right: -250px;
  background: #1d8b4b;
}


/* TOP BAR */

.topbar {
  width: min(1200px, calc(100% - 40px));

  margin: auto;

  height: 80px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(255,255,255,.06);
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;

  color: white;
  text-decoration: none;

  font-size: 18px;
  font-weight: 900;

  letter-spacing: 2px;
}

.logo-mark {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #69ff9a,
      #20b957
    );

  color: #061009;

  box-shadow:
    0 0 25px rgba(87,242,135,.25);
}

.green {
  color: var(--green);
}

nav {
  display: flex;
  gap: 5px;
}

nav button {
  border: 0;

  background: transparent;

  color: #89948c;

  padding: 10px 13px;

  font-size: 12px;

  border-radius: 9px;

  transition: .2s;
}

nav button:hover {
  color: white;
  background: rgba(255,255,255,.05);
}

.status {
  display: flex;
  align-items: center;
  gap: 8px;

  font-size: 9px;
  font-weight: bold;

  color: #89958d;

  letter-spacing: 1px;
}

.status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--green);

  box-shadow:
    0 0 12px var(--green);
}


/* HERO */

.hero {
  max-width: 950px;

  margin: auto;

  text-align: center;

  padding:
    105px 20px
    90px;
}

.hero-badge {
  display: inline-flex;

  align-items: center;
  gap: 8px;

  padding: 8px 13px;

  border-radius: 30px;

  border: 1px solid rgba(87,242,135,.2);

  background: rgba(87,242,135,.06);

  color: #9caf9f;

  font-size: 9px;
  font-weight: bold;

  letter-spacing: 2px;
}

.hero-badge span {
  color: var(--green);
}

.hero h1 {
  margin: 27px 0 20px;

  font-size: clamp(55px, 9vw, 100px);

  line-height: .92;

  letter-spacing: -6px;

  font-weight: 850;
}

.hero h1 span {
  background:
    linear-gradient(
      90deg,
      #ffffff,
      #57f287
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.hero-text {
  max-width: 580px;

  margin: auto;

  color: var(--muted);

  font-size: 16px;

  line-height: 1.7;
}

.hero-buttons {
  display: flex;

  justify-content: center;

  gap: 10px;

  margin-top: 35px;
}

.primary-button,
.secondary-button {
  display: flex;

  align-items: center;
  gap: 12px;

  padding: 16px 20px;

  border-radius: 13px;

  font-weight: bold;

  transition: .2s;
}

.primary-button {
  border: 0;

  background: var(--green);

  color: #061009;

  box-shadow:
    0 10px 40px rgba(87,242,135,.18);
}

.primary-button:hover {
  transform: translateY(-3px);

  box-shadow:
    0 15px 45px rgba(87,242,135,.3);
}

.secondary-button {
  border: 1px solid var(--border);

  background: rgba(255,255,255,.035);

  color: white;
}

.secondary-button:hover {
  background: rgba(255,255,255,.07);
}

.primary-button b,
.secondary-button b {
  margin-left: 5px;
}

.hero-stats {
  display: flex;

  justify-content: center;

  gap: 50px;

  margin-top: 55px;
}

.hero-stats div {
  display: flex;

  flex-direction: column;

  gap: 5px;
}

.hero-stats strong {
  font-size: 18px;
}

.hero-stats span {
  color: #68746c;

  font-size: 8px;

  letter-spacing: 2px;
}


/* SECTIONS */

.section {
  max-width: 1100px;

  margin: auto;

  padding:
    40px 20px
    100px;
}

.section-heading {
  display: flex;

  justify-content: space-between;

  align-items: end;

  margin-bottom: 30px;
}

.section-label {
  color: var(--green);

  font-size: 9px;

  font-weight: bold;

  letter-spacing: 3px;
}

.section-heading h2 {
  font-size: 40px;

  margin: 9px 0 0;

  letter-spacing: -2px;
}

.section-heading p {
  max-width: 280px;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.6;
}


/* SERVICE CARDS */

.services {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 15px;
}

.service-card {
  min-height: 310px;

  position: relative;

  text-align: left;

  padding: 27px;

  overflow: hidden;

  border-radius: 22px;

  border: 1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(24,36,28,.82),
      rgba(8,12,9,.88)
    );

  color: white;

  transition:
    transform .25s,
    border .25s,
    box-shadow .25s;
}

.service-card::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -80px;
  bottom: -100px;

  border-radius: 50%;

  background: var(--green);

  filter: blur(80px);

  opacity: .07;

  transition: .3s;
}

.service-card:hover {
  transform: translateY(-6px);

  border-color:
    rgba(87,242,135,.35);

  box-shadow:
    0 20px 60px rgba(0,0,0,.3);
}

.service-card:hover::after {
  opacity: .16;
}

.card-top {
  display: flex;

  justify-content: space-between;
}

.service-icon {
  width: 50px;
  height: 50px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background:
    rgba(87,242,135,.08);

  border:
    1px solid rgba(87,242,135,.12);

  font-size: 23px;
}

.arrow {
  font-size: 20px;

  color: #6f7b72;
}

.service-number {
  margin-top: 40px;

  color: #4d5b51;

  font-size: 10px;

  font-weight: bold;

  letter-spacing: 2px;
}

.service-card h3 {
  margin: 8px 0;

  font-size: 25px;

  letter-spacing: -.5px;
}

.service-card p {
  max-width: 330px;

  color: #8c988f;

  font-size: 13px;

  line-height: 1.6;
}

.card-link {
  position: absolute;

  bottom: 25px;

  color: var(--green);

  font-size: 11px;

  font-weight: bold;
}


/* AI */

.ai-section {
  max-width: 1100px;

  margin: auto;

  padding:
    20px 20px
    100px;
}

.ai-panel {
  border: 1px solid rgba(87,242,135,.2);

  border-radius: 28px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(87,242,135,.09),
      transparent 30%
    ),
    #0a100c;

  box-shadow:
    0 30px 100px rgba(0,0,0,.35);
}

.ai-top {
  padding: 20px 25px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  border-bottom:
    1px solid rgba(255,255,255,.06);
}

.ai-brand {
  display: flex;

  align-items: center;

  gap: 12px;
}

.ai-orb {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #59f28a,
      #167e3b
    );

  color: #061009;

  box-shadow:
    0 0 30px rgba(87,242,135,.2);
}

.ai-name {
  font-size: 12px;

  font-weight: 900;

  letter-spacing: 1px;
}

.ai-subtitle {
  margin-top: 3px;

  color: #69766e;

  font-size: 8px;

  letter-spacing: 1px;
}

.ai-live {
  display: flex;

  align-items: center;

  gap: 7px;

  color: var(--green);

  font-size: 9px;

  font-weight: bold;
}

.ai-live span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--green);
}

.ai-content {
  display: grid;

  grid-template-columns: .8fr 1.2fr;

  gap: 40px;

  padding: 55px;
}

.small-label {
  color: #667269;

  font-size: 8px;

  font-weight: bold;

  letter-spacing: 2px;
}

.ai-welcome h2 {
  font-size: 43px;

  line-height: 1;

  letter-spacing: -2px;

  margin: 15px 0;
}

.ai-welcome h2 span {
  color: var(--green);
}

.ai-welcome p {
  max-width: 330px;

  color: #7f8b82;

  line-height: 1.6;

  font-size: 13px;
}

.chat-area {
  display: flex;

  flex-direction: column;

  justify-content: center;
}

.ai-message {
  display: flex;

  gap: 12px;

  padding: 17px;

  border-radius: 15px;

  background: rgba(255,255,255,.035);

  border: 1px solid rgba(255,255,255,.06);
}

.message-icon {
  color: var(--green);
}

.ai-message strong {
  font-size: 12px;
}

.ai-message p {
  margin: 5px 0 0;

  color: #8a958d;

  font-size: 12px;
}

.chat-input {
  display: flex;

  gap: 8px;

  margin-top: 10px;
}

.chat-input input {
  flex: 1;

  min-width: 0;

  border: 1px solid rgba(255,255,255,.09);

  border-radius: 13px;

  background: #070b08;

  color: white;

  padding: 15px;

  outline: none;
}

.chat-input input:focus {
  border-color:
    rgba(87,242,135,.4);
}

.chat-input button {
  width: 50px;

  border: 0;

  border-radius: 13px;

  background: var(--green);

  color: #061009;

  font-size: 20px;

  font-weight: bold;
}


/* FEATURE */

.feature-section {
  max-width: 1100px;

  margin: auto;

  padding:
    30px 20px
    110px;

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 50px;

  align-items: center;
}

.feature-content h2 {
  font-size: 52px;

  line-height: .95;

  letter-spacing: -3px;

  margin: 15px 0 20px;
}

.feature-content h2 span {
  color: var(--green);
}

.feature-content p {
  max-width: 480px;

  color: var(--muted);

  line-height: 1.7;

  font-size: 14px;
}

.feature-content button {
  margin-top: 15px;

  border: 1px solid #304034;

  border-radius: 12px;

  padding: 14px 18px;

  background: #111a14;

  color: white;
}

.feature-content button span {
  color: var(--green);

  margin-left: 10px;
}


/* ORBIT */

.feature-decoration {
  height: 350px;

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;
}

.core {
  width: 90px;
  height: 90px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      #6cff9a,
      #167e3b
    );

  color: #061009;

  font-size: 35px;

  font-weight: 900;

  box-shadow:
    0 0 70px rgba(87,242,135,.35);
}

.orbit {
  position: absolute;

  border: 1px solid rgba(87,242,135,.15);

  border-radius: 50%;
}

.orbit-one {
  width: 150px;
  height: 150px;
}

.orbit-two {
  width: 240px;
  height: 240px;
}

.orbit-three {
  width: 330px;
  height: 330px;
}


/* FOOTER */

footer {
  border-top: 1px solid rgba(255,255,255,.06);

  text-align: center;

  padding: 35px;

  color: #566158;
}

.footer-logo {
  color: white;

  font-weight: 900;

  letter-spacing: 2px;
}

.footer-logo span {
  color: var(--green);
}

footer p {
  font-size: 11px;
}

footer > span {
  font-size: 9px;
}


/* TOAST */

#toast {
  position: fixed;

  bottom: 30px;
  left: 50%;

  transform:
    translateX(-50%)
    translateY(20px);

  opacity: 0;

  padding: 13px 20px;

  border-radius: 30px;

  background: #eafff0;

  color: #07100a;

  font-size: 11px;

  font-weight: bold;

  pointer-events: none;

  transition: .25s;

  z-index: 100;
}

#toast.show {
  opacity: 1;

  transform:
    translateX(-50%)
    translateY(0);
}


/* MOBILE */

@media (max-width: 750px) {

  .topbar {
    width: calc(100% - 25px);
  }

  nav {
    display: none;
  }

  .status {
    font-size: 8px;
  }

  .hero {
    padding:
      75px 15px
      70px;
  }

  .hero h1 {
    font-size: 58px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons button {
    justify-content: center;
  }

  .hero-stats {
    gap: 25px;
  }

  .services {
    grid-template-columns: 1fr;
  }

  .section-heading {
    display: block;
  }

  .section-heading h2 {
    font-size: 32px;
  }

  .section-heading p {
    margin-top: 15px;
  }

  .ai-content {
    grid-template-columns: 1fr;

    padding: 30px;
  }

  .ai-welcome h2 {
    font-size: 38px;
  }

  .feature-section {
    grid-template-columns: 1fr;
  }

  .feature-content h2 {
    font-size: 43px;
  }

  .feature-decoration {
    height: 280px;
  }

  .orbit-three {
    width: 260px;
    height: 260px;
  }

}
